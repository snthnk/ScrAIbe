# --- VseLLM (OpenAI-совместимый шлюз) ---
# Ключ из личного кабинета VseLLM
VSELLM_API_KEY=your_vsellm_api_key_here
# Адрес шлюза; если в кабинете указан другой, впишите его
VSELLM_BASE_URL=https://api.vsellm.ru/v1
# Модель по её id из кабинета или из `python scripts/list_models.py`
VSELLM_MODEL_NAME=claude-haiku-5.5
# Модель для эксперта (разбор по критериям, смысловой анализ); пусто — та же, что основная
# VSELLM_EXPERT_MODEL_NAME=
# Температура; пусто — не передавать (часть моделей не принимает свою)
# LLM_TEMPERATURE=0.2

# --- LLM API Keys ---
# API key for Google Gemini (either GOOGLE_API_KEY or GEMINI_API_KEY can be used)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# API key for Mistral AI (used if LLM_PROVIDER is set to 'mistral')
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Search API Keys ---
# API key for Tavily Web Search
TAVILY_API_KEY=your_tavily_api_key_here

# --- LLM Configuration ---
# LLM Provider to use ('vsellm', 'mistral' or 'gemini')
LLM_PROVIDER=vsellm

# Specific model override options
# Recommended models:
# - Mistral (free tier compatible, no 403 errors): ministral-8b-latest, open-mistral-7b
# - Gemini: gemini-3.6-flash
MISTRAL_MODEL_NAME=ministral-8b-latest
MISTRAL_EXPERT_MODEL_NAME=ministral-8b-latest
GEMINI_MODEL_NAME=gemini-3.6-flash

# 0 — не использовать запасные модели (в оценке выключено по умолчанию)
# LLM_FALLBACKS=1

# --- Выбор инструмента ---
# llm   — инструмент выбирает модель (function calling), при сбое подстраховывают ключевые правила (по умолчанию)
# rules — только ключевые правила, без обращения к LLM
TOOL_SELECTION_MODE=llm

# --- RAG (литературные аргументы) ---
# e5   — intfloat/multilingual-e5-large (скачивается при первом запуске, ~2 ГБ)
# hash — офлайн-заглушка без модели (для проверки конвейера, качество поиска низкое)
RAG_EMBEDDER=e5
# Модель поменьше, если не хватает памяти: intfloat/multilingual-e5-small
# RAG_EMBEDDER_MODEL=intfloat/multilingual-e5-large
# Другая база аргументов (CSV с колонками id,title,author,argument,tags)
# RAG_ARGUMENTS_CSV=data/arguments.csv

# --- Logging Configuration ---
LOG_LEVEL=INFO
LOG_TO_FILE=1
LOG_FILE=logs/scraibe.log

# Show reasoning process logs in terminal / UI ("0" for disabled, "1" for enabled)
SHOW_REASONING=1

# --- NLP Module Configuration ---
# Timeout in seconds for Yandex Speller API requests
NLP_SPELLER_TIMEOUT=5.0

# Enable/disable Sage punctuation correction ("0" for disabled, "1" for enabled)
# Note: Enabling Sage requires installing 'torch' and 'transformers' which are heavy libraries
NLP_ENABLE_SAGE=0

# Sage model name to use from Hugging Face if enabled
SAGE_MODEL_NAME=ai-forever/sage-v1.1.0

